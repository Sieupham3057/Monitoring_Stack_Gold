        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace(label_replace(container_memory_usage_bytes{image!=\"\"} / 1024 / 1024, \"service\", \"$1\", \"image\", \".*/([^/:]+):.*\"), \"service\", \"sqlserver\", \"image\", \".*mssql.*\")",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns" }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container_label_com_docker_engine_bundle_path": true,
              "cpu": true,
              "host": true,
              "id": true,
              "instance": true,
              "job": true,
              "name": true
